# huazai-trip-plan 环境变量样例（C-003 AC-4）
# 用法：cp .env.example .env 后填入真实值。
# 安全红线（编码规范 §7）：真实 .env 已在 .gitignore，禁止提交任何明文密钥/口令。

# —— 外部服务密钥（dev/prod profile 缺失将 fail-fast 并点名变量）——
# 主 LLM：DeepSeek 官方 deepseek-v4-pro（ADR-009）
DEEPSEEK_API_KEY=your-deepseek-api-key
# 降级 LLM：DashScope qwen3-max（deepseek 运行期不可用时原生切回）
DASHSCOPE_API_KEY=your-dashscope-api-key
BAIDU_MAP_AK=your-baidu-map-ak
AMAP_MAP_AK=your-amap-map-ak

# —— Redis（短期状态，24h TTL，不落盘）——
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=huazai

# —— Nacos（A2A 服务发现/配置；注册逻辑归 C-005，本期仅就位）——
NACOS_SERVER_ADDR=127.0.0.1:8848

# —— ReMe 长期记忆服务（C-015）——
# ReMe Server 地址（Java 侧 ReMeClient 连接）
REME_BASE_URL=http://127.0.0.1:8002
# ReMe Server 端口（Docker Compose 宿主映射）
REME_PORT=8002

# —— Docker Compose 宿主端口覆盖（可选，默认见 docker/docker-compose.yml）——
NACOS_PORT=8848

# —— 运行 profile（local/dev/test）——
SPRING_PROFILES_ACTIVE=local

# MCP 长短链接配置 short/long
AMAP_MCP_CONNECTION_MODE=long
