# 启动期环境变量 fail-fast 监听器注册（C-003 AC-3/AC-4）
org.springframework.context.ApplicationListener=\
  com.smart.trip.server.config.EnvironmentValidationListener

# .env 文件加载（最早阶段注入 Spring Environment）
org.springframework.context.ApplicationContextInitializer=\
  com.smart.trip.server.config.DotenvApplicationInitializer
