<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smart.trip</groupId>
        <artifactId>smart-trip-plan</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>smart-trip-agent-supervisor</artifactId>
    <packaging>jar</packaging>
    <name>smart-trip-agent-supervisor</name>
    <description>SupervisorAgent：需求理解、任务分解、结果汇总（agent://supervisor）。Agent 间仅通过 A2A 通信，禁止直接依赖其它 agent（R1）。</description>

    <!-- 依赖方向：agent → common, skills（agentscope 经 skills 传递）。禁止依赖其它 smart-trip-agent-* 与 server。 -->
    <dependencies>
        <dependency>
            <groupId>com.smart.trip</groupId>
            <artifactId>smart-trip-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smart.trip</groupId>
            <artifactId>smart-trip-skills</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 测试栈（版本由根 spring-boot-dependencies 统一管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存数据库（trace 持久化单测用） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              JaCoCo 覆盖率门禁（C-002 AC-4 / C-010）：supervisor 核心逻辑 ≥80% 行覆盖；
              排除 SupervisorHarnessAgentFactory（涉及真实 LLM/网络，对齐 C-006~C-009 排除模式）。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/package-info.class</exclude>
                        <!-- C-010：HarnessAgent 工厂涉及真实 deepseek-v4-pro/qwen3-max + 网络调用，
                             单测不可离线覆盖，对齐 C-006~C-009 的 HarnessAgentFactory 排除模式。 -->
                        <exclude>**/SupervisorHarnessAgentFactory.class</exclude>
                        <!-- TraceThreadPoolConfig 为纯线程池配置工具类（无业务逻辑），排除行覆盖。 -->
                        <exclude>**/TraceThreadPoolConfig.class</exclude>
                        <exclude>**/TraceThreadPoolConfig$*.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <!-- 激活本模块 JaCoCo check：核心逻辑非空，参与 ≥80% 门禁 -->
        <jacoco.check.skip>false</jacoco.check.skip>
    </properties>

</project>
